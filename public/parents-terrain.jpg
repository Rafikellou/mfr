<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="400" fill="#f3f4f6"/>
  
  <!-- Football field -->
  <rect x="50" y="50" width="700" height="300" fill="#22c55e" stroke="#16a34a" stroke-width="2"/>
  
  <!-- Field lines -->
  <line x1="50" y1="200" x2="750" y2="200" stroke="white" stroke-width="2" stroke-dasharray="10,10"/>
  <circle cx="400" cy="200" r="50" fill="none" stroke="white" stroke-width="2"/>
  <rect x="50" y="100" width="100" height="200" fill="none" stroke="white" stroke-width="2"/>
  <rect x="650" y="100" width="100" height="200" fill="none" stroke="white" stroke-width="2"/>
  
  <!-- Parents on the side -->
  <circle cx="30" cy="150" r="15" fill="#93c5fd"/>
  <circle cx="30" cy="250" r="15" fill="#93c5fd"/>
  
  <!-- Children playing -->
  <circle cx="200" cy="180" r="12" fill="#fbbf24"/>
  <circle cx="300" cy="220" r="12" fill="#fbbf24"/>
  <circle cx="400" cy="190" r="12" fill="#fbbf24"/>
  
  <!-- Coach -->
  <circle cx="100" cy="200" r="14" fill="#c084fc"/>
  
  <!-- Title -->
  <text x="400" y="30" font-family="Arial, sans-serif" font-size="24" fill="#4b5563" text-anchor="middle" font-weight="bold">
    Le rôle des parents au bord du terrain
  </text>
  
  <!-- Subtitle -->
  <text x="400" y="370" font-family="Arial, sans-serif" font-size="16" fill="#6b7280" text-anchor="middle">
    Soutenir vos enfants dans leur pratique du football
  </text>
</svg>